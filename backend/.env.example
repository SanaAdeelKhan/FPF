# Copy this file to .env and fill in real values. Never commit .env itself.

# LLM provider key used for CV parsing, matching, and explanation generation
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Database (SQLite for local/demo use; swap for Postgres URL in production)
DATABASE_URL=sqlite:///./fpf.db

# Comma-separated list of origins allowed to call the API (your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.netlify.app

# Environment name: local | staging | production
ENVIRONMENT=local
